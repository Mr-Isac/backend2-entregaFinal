<h1>Productos</h1>
<a href="/carts/6a62b7d0009eec4f4fb70fab">
    Ver carrito
</a>
<div>
  {{#each products}}

    <div>
      <h3>{{title}}</h3>

      <p>
        {{description}}
      </p>

      <p>
        Precio: ${{price}}
      </p>

      <p>
        Categoría:
        {{category}}
      </p>

      <p>
        Stock:
        {{stock}}
      </p>

      <button class="addCart" data-id="{{_id}}">
        Agregar al carrito
      </button>

      <hr />

    </div>

  {{/each}}
</div>

<div>

  {{#if hasPrevPage}}
    <a href="{{prevLink}}">
      Página anterior
    </a>
  {{/if}}

  <span>
    Página
    {{page}}
    de
    {{totalPages}}
  </span>

  {{#if hasNextPage}}
    <a href="{{nextLink}}">
      Página siguiente
    </a>
  {{/if}}

</div>
<script src="/js/products.js"></script>